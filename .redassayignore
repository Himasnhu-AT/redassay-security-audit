# redassay scanning redassay finds its own vocabulary. These paths exist to
# contain vulnerability patterns, so scanning them produces noise and nothing
# else.

# Rule packs and scanners: vulnerability patterns are the payload.
engine/redassay/rules/
engine/redassay/scanners/
engine/redassay/data/

# The test corpus: every scanner test asserts on a vulnerable sample, and the
# false-positive suite deliberately contains both safe and unsafe forms.
tests/

# Deliberately vulnerable applications, used to prove detection still works.
fixtures/

# The benchmarks submodule: 104 deliberately vulnerable applications, present as
# a corpus to scan deliberately rather than something to audit on every
# self-scan. Point redassay at it explicitly:
#   redassay --root benchmarks/validation-benchmarks scan
benchmarks/
